      "description": "正常：Gateway 有健康实例；异常：数值为 0 或突然下降，优先排查 Knoway 入口和 Pod。",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 101,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.3.14",
      "targets": [
        {
          "expr": "sum(up{cluster_name=~\"$cluster\",namespace=\"hydra-system\",job=~\"knoway-gateway.*\"})",
          "refId": "A"
        }
      ],
      "title": "Knoway Gateway Healthy",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
